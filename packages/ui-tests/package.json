{
  "name": "@kaoto/kaoto-tests",
  "private": true,
  "version": "0.0.0-dev",
  "type": "module",
  "description": "Kaoto UI tests and storybook",
  "repository": "https://github.com/KaotoIO/kaoto",
  "repositoryDirectory": "packages/ui-tests",
  "author": {
    "name": "The Kaoto Team"
  },
  "license": "Apache License v2.0",
  "scripts": {
    "e2e": "cypress open --config-file=cypress.config.ts",
    "e2e:headless": "cypress run --expose grepTags=-weekly",
    "e2e:headless-weekly": "cypress run --expose grepTags=weekly",
    "e2e-preview": "cypress open --config-file=cypress.config.ts --config baseUrl=http://localhost:4173/",
    "e2e-preview:headless": "cypress run --config baseUrl=http://localhost:4173/",
    "lint": "yarn eslint \"cypress/**/*.{ts,tsx}\" \"stories/**/*.{ts,tsx}\"",
    "lint:fix": "yarn lint --fix",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "chromatic": "chromatic --build-script-name 'build:storybook' --exit-zero-on-changes --project-token=$CHROMATIC_PROJECT_TOKEN"
  },
  "devDependencies": {
    "@cypress/grep": "^7.0.0",
    "@eslint/js": "^9.10.0",
    "@patternfly/patternfly": "^6.6.1",
    "@patternfly/react-core": "6.6.1",
    "@patternfly/react-icons": "^6.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@storybook/testing-library": "^0.2.2",
    "@types/eslint__js": "^8.42.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "chromatic": "^18.8.1",
    "cypress": "^16.0.0",
    "cypress-file-upload": "^5.0.8",
    "cypress-real-events": "^1.15.1",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "msw": "^2.0.2",
    "msw-storybook-addon": "^2.0.3",
    "prettier": "^3.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router": "^7.6.4",
    "start-server-and-test": "^2.0.0",
    "storybook-addon-remix-react-router": "^6.0.0",
    "storybook-fixtures": "0.12.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@kaoto/camel-catalog": "^0.10.6",
    "@kaoto/forms": "^1.9.0",
    "@kaoto/kaoto": "workspace:*",
    "storybook": "^10.6.1"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
