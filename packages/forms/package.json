{
  "name": "@kaoto/forms",
  "version": "0.0.0-dev",
  "type": "module",
  "description": "Kaoto Forms",
  "repository": "https://github.com/KaotoIO/kaoto",
  "repositoryDirectory": "packages/forms",
  "author": "The Kaoto Team",
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "types": "./dist/index.d.ts",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "@kaoto/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@kaoto/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./testing/page-object": {
      "@kaoto/source": "./src/testing/KaotoFormPageObject.ts",
      "types": "./dist/testing/KaotoFormPageObject.d.ts",
      "default": "./dist/testing/KaotoFormPageObject.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "yarn rimraf dist && yarn build:lib",
    "build:lib": "tsc --project tsconfig.lib.json && copyfiles -u 1 ./src/**/*.scss ./dist",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run --config vitest.config.mts --coverage",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "yarn lint --fix",
    "lint:style": "yarn stylelint \"src/**/*.{css,scss}\"",
    "lint:style:fix": "yarn lint:style --fix"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "clsx": "^2.1.0",
    "lodash": "^4.17.21",
    "usehooks-ts": "^3.0.0"
  },
  "peerDependencies": {
    "@carbon/ibm-products": "^2.74.0",
    "@carbon/icons-react": "^11.67.0",
    "@carbon/react": "^1.102.0",
    "@carbon/styles": "^1.99.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@carbon/ibm-products": "^2.74.0",
    "@carbon/icons-react": "^11.89.0",
    "@carbon/react": "^1.102.0",
    "@carbon/styles": "^1.99.0",
    "@eslint/js": "^9.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/json-schema": "^7.0.15",
    "@types/lodash": "^4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "copyfiles": "^2.4.1",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.9.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-is": "^19.0.0",
    "react-test-renderer": "^19.2.4",
    "rimraf": "^6.1.3",
    "sass": "npm:sass-embedded@^1.105.1",
    "sass-embedded": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-prettier": "^5.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.1"
  }
}
