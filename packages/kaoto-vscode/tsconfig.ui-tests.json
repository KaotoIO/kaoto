{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "noEmit": false,
    /* Emit to out/<group>/: extester.config.json, test:ui:vsix:* scripts and __dirname fixture paths rely on it. */
    "rootDir": "src/ui-test",
    "target": "ES2023",
    "lib": ["ES2023"],
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "resolveJsonModule": true,
    "outDir": "out"
  },
  "include": ["src/ui-test"]
}
