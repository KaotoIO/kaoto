{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "noEmit": false,
    "rootDir": "src",
    "target": "ES2023",
    "lib": ["ES2023"],
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "resolveJsonModule": true,
    "outDir": "out"
  },
  "include": ["src/ui-test"]
}
