{
  "extends": "../../tsconfig.base.json",
  "exclude": ["node_modules", ".vscode-test", "test-resources"],
  "include": ["src", "../editor-api/src"],
  "compilerOptions": {
    /*
     * Build target — webpack bundles this. noEmit is inherited from the base so that a
     * `tsc -b` from the repository root never writes .js next to the sources; ts-loader
     * (webpack.config.js) and the test tsconfigs re-enable emit explicitly.
     */
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "isolatedModules": false,

    /* kaoto-vscode-specific flags */
    "removeComments": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true
  }
}
