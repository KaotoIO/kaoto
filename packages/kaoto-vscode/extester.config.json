{
  "$schema": "../../node_modules/vscode-extension-tester/resources/extester.schema.json",
  "setup": {
    "extensionsDir": "./test-resources",
    "packageOptions": {
      "useYarn": true,
      "dependencies": false
    }
  },
  "run": {
    "testFiles": [
      "out-ui-tests/settings/*.test.js",
      "out-ui-tests/editor/*.test.js",
      "out-ui-tests/views/*.test.js",
      "out-ui-tests/deploy/*.test.js",
      "out-ui-tests/export/*.test.js"
    ],
    "resources": ["./test Fixture with speci@l chars"],
    "extensionsDir": "./test-resources",
    "settings": "./src/ui-test/vscode-settings.json",
    "mochaConfig": "./src/ui-test/.mocharc.json",
    "customPageObjects": "./out-ui-tests/pageObjects/locators.js"
  }
}
