{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "5.0",
    "rootDir": ".",
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "resolveJsonModule": true,
    "outDir": "out/test"
  },
  "include": ["src/test"],
  "exclude": [
    "node_modules",
    ".vscode-test",
    "test-resources",
    "src/test/services/KaotoHostServices.test.ts",
    "src/test/extension/KaotoEditorProvider.test.ts",
    "src/test/web/**"
  ]
}
