{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "rootDir": "src",
    "paths": {
      "@kaoto/camel-catalog/types": ["../../node_modules/@kaoto/camel-catalog/dist/types/index.ts"],
      "@kaoto/kaoto/models": ["../../node_modules/@kaoto/kaoto/lib/models-api.d.ts"],
      "@kaoto/kaoto": ["../../node_modules/@kaoto/kaoto/lib/public-api.d.ts"]
    },
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "resolveJsonModule": true,
    "outDir": "out"
  },
  "include": ["src/test"]
}
