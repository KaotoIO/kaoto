{
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist/client",
    "rootDir": "./build/generated",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["build/generated/**/*"]
}
