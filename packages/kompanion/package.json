{
  "name": "@kaoto/kompanion",
  "private": true,
  "version": "0.0.0-dev",
  "type": "module",
  "description": "Kaoto kompanion",
  "repository": "https://github.com/KaotoIO/kaoto",
  "repositoryDirectory": "packages/kompanion",
  "author": "The Kaoto Team",
  "license": "Apache License v2.0",
  "main": "./index.js",
  "files": [
    "dist"
  ],
  "exports": {
    "./client": "./dist/client/client/index.js",
    "./client/*": "./dist/client/client/*.js",
    "./model": "./dist/client/model/index.js",
    "./model/*": "./dist/client/model/*.js",
    "./openapi": "./dist/openapi/openapi.json"
  },
  "scripts": {
    "mvnw:run": "node scripts/mvnw.mjs",
    "build": "yarn mvnw:run clean install && yarn build:sdk",
    "build:kompanion": "yarn mvnw:run clean package -pl kaoto-kompanion -am",
    "build:sdk": "orval --config orval.config.ts && tsc --project tsconfig.sdk.json",
    "lint": "yarn mvnw:run spotless:check",
    "lint:fix": "yarn mvnw:run spotless:apply",
    "test": "yarn mvnw:run test",
    "test:e2e": "yarn build:kompanion && yarn mvnw:run verify -pl kaoto-e2e"
  },
  "devDependencies": {
    "orval": "^8.40.0",
    "typescript": "^6.0.0"
  }
}
