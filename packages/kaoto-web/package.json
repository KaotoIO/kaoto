{
  "name": "@kaoto/kaoto-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "yarn type-check && vite build",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "yarn lint:es && yarn lint:style && yarn lint:format",
    "lint-fix": "yarn lint:es --fix && yarn lint:style --fix && yarn lint:format:fix",
    "lint:es": "eslint . --report-unused-disable-directives --cache --cache-location \"node_modules/.cache/eslint/\"",
    "lint:style": "stylelint \"./**/*.scss\" --cache --cache-location \"node_modules/.cache/stylelint/\"",
    "lint:format": "prettier . --check --ignore-unknown --no-error-on-unmatched-pattern --log-level warn --cache --cache-location \"node_modules/.cache/prettier/\"",
    "lint:format:fix": "prettier . --write --ignore-unknown --no-error-on-unmatched-pattern --log-level warn --cache --cache-location \"node_modules/.cache/prettier/\"",
    "test": "cd ../.. && node_modules/.bin/vitest run --project kaoto-web --coverage --config vitest.config.ts",
    "test:watch": "cd ../.. && node_modules/.bin/vitest --project kaoto-web --watch --config vitest.config.ts"
  },
  "dependencies": {
    "@carbon-labs/react-theme-settings": "^0.21.0",
    "@carbon-labs/utilities": "^0.21.0",
    "@carbon/ibm-products": "^2.74.0",
    "@carbon/react": "^1.102.0",
    "@ibm/plex": "^6.4.1",
    "classnames": "^2.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.0.0",
    "react-router": "^7.5.2"
  },
  "devDependencies": {
    "@carbon-labs/vscode-snippets": "^0.2.0",
    "@double-great/stylelint-a11y": "^3.0.4",
    "@eslint/js": "^9.21.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitest/eslint-plugin": "^1.6.20",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "5.1.0-rc-eb3ad065-20240822",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.0.0",
    "msw": "^2.7.3",
    "prettier": "^3.5.3",
    "sass-embedded": "^1.85.1",
    "stylelint": "^16.1.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "stylelint-plugin-carbon-tokens": "^4.0.0",
    "stylelint-use-logical-spec": "^5.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  },
  "packageManager": "yarn@4.12.0"
}
