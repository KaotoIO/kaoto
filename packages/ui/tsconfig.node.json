{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    /* vite.config.mjs and the scripts it imports are JS checked through `// @ts-check` */
    "allowJs": true
  },
  "include": ["vite.config.mjs", "vitest.config.mts"]
}
