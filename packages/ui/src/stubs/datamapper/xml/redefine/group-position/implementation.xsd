<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:x="urn:x" targetNamespace="urn:x" elementFormDefault="qualified">
  <xs:redefine schemaLocation="base.xsd">
    <xs:group name="G">
      <xs:sequence>
        <xs:element name="pre" type="xs:string"/>
        <xs:group ref="x:G"/>
        <xs:element name="post" type="xs:string"/>
      </xs:sequence>
    </xs:group>
    <xs:group name="L">
      <xs:sequence>
        <xs:element name="first" type="xs:string"/>
        <xs:group ref="x:L"/>
      </xs:sequence>
    </xs:group>
  </xs:redefine>
  <xs:element name="Root">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="head" type="xs:string"/>
        <xs:group ref="x:G"/>
        <xs:group ref="x:L"/>
        <xs:element name="tail" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
