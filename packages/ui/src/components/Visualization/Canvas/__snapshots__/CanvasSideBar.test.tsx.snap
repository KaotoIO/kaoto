exports[`CanvasSideBar > displays selected node information 1`] = `
<DocumentFragment>
  <div
    class="pf-topology-resizable-side-bar canvas-sidebar"
    role="dialog"
  >
    <div
      class="cds--layer-two canvas-sidebar__layer"
    >
      <div
        class="canvas-form"
      >
        <div
          class="canvas-form__header"
        >
          <div
            class="form-header-row"
          >
            <div
              class="form-header"
            >
              <img
                alt="timer"
                class="form-header__icon-route.from"
                src="/src/assets/components/timer.svg"
              />
              <h2
                class="form-header__title"
              >
                timer
              </h2>
            </div>
            <span
              class="cds--popover-container cds--popover--caret cds--popover--high-contrast cds--popover--top cds--tooltip cds--icon-tooltip"
            >
              <div
                class="cds--tooltip-trigger__wrapper"
              >
                <button
                  aria-labelledby="tooltip-_r_ID_"
                  class="canvas-header-close cds--btn cds--btn--sm cds--layout--size-sm cds--btn--ghost cds--btn--icon-only"
                  data-testid="close-side-bar"
                  type="button"
                >
                  <svg
                    aria-hidden="true"
                    fill="currentColor"
                    focusable="false"
                    height="16"
                    preserveAspectRatio="xMidYMid meet"
                    viewBox="0 0 32 32"
                    width="16"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M17.4141 16 24 9.4141 22.5859 8 16 14.5859 9.4143 8 8 9.4141 14.5859 16 8 22.5859 9.4143 24 16 17.4141 22.5859 24 24 22.5859 17.4141 16z"
                    />
                  </svg>
                </button>
              </div>
              <span
                aria-hidden="true"
                class="cds--popover"
                id="tooltip-_r_ID_"
                role="tooltip"
              >
                <span
                  class="cds--popover-content cds--tooltip-content"
                >
                  Close
                </span>
                <span
                  class="cds--popover-caret"
                />
              </span>
            </span>
          </div>
        </div>
        <div
          class="canvas-form__body"
        >
          <div
            class="pf-v6-c-card"
            data-ouia-component-id="OUIA-Generated-Card-_r_ID_"
            data-ouia-component-type="PF6/Card"
            data-ouia-safe="true"
            id=""
          >
            <div
              class="pf-v6-c-card__header"
            >
              <div
                class="pf-v6-c-card__header-main"
              >
                <div
                  class="pf-v6-c-card__title"
                >
                  <div
                    class="pf-v6-c-card__title-text"
                  >
                    Node source
                  </div>
                </div>
              </div>
            </div>
            <div
              class="pf-v6-c-card__body"
            >
              <div
                class="pf-v6-c-code-block"
              >
                <div
                  class="pf-v6-c-code-block__content"
                >
                  <pre
                    class="pf-v6-c-code-block__pre"
                  >
                    <code
                      class="pf-v6-c-code-block__code"
                    >
                      id: from-1234
uri: timer
parameters:
  period: "1000"
  timerName: template
steps:
  - log:
      id: log-1234
      message: \${body}

                    </code>
                  </pre>
                </div>
              </div>
            </div>
            <div
              class="pf-v6-c-card__footer"
            >
              <div
                class="pf-v6-c-alert pf-m-warning"
                data-ouia-component-id="OUIA-Generated-Alert-warning-_r_ID_"
                data-ouia-component-type="PF6/Alert"
                data-ouia-safe="true"
              >
                <div
                  class="pf-v6-c-alert__icon"
                >
                  <svg
                    aria-hidden="true"
                    class="pf-v6-svg"
                    fill="currentColor"
                    height="1em"
                    role="img"
                    viewBox="0 0 32 32"
                    width="1em"
                  >
                    <path
                      d="m31.874 28.514-15.011-27a1.001 1.001 0 0 0-1.748 0l-15.011 27A1 1 0 0 0 .978 30H31a1 1 0 0 0 .874-1.486ZM14.5 12a1.5 1.5 0 0 1 3 0v5a1.5 1.5 0 0 1-3 0v-5ZM16 26.001a2 2 0 1 1-.001-3.999A2 2 0 0 1 16 26.001Z"
