{
  "extends": "../../tsconfig.lib.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",
    "rootDir": "src",
    "outDir": "lib",
    "inlineSources": true
  },
  "include": [
    "src/public-api.ts",
    "src/models-api.ts",
    "src/testing-api.ts",
    "src/components-api.ts",
    "src/global.d.ts",
    "src/vite-env.d.ts",
    "../forms/src"
  ],
  "exclude": ["src/**/*.test.tsx", "src/**/*.test.ts", "src/**/stubs/**"]
}
