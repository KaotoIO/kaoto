<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.kaoto</groupId>
    <artifactId>kaoto-companion-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <properties>
        <revision>1.0.0-SNAPSHOT</revision>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.version>3.38.2</quarkus.platform.version>
        <camel.version>4.10.3</camel.version>
        <!-- ContextServicePlugin exists from Camel 4.15; the adapter module compiles against the first LTS that has it.
             Fixed on purpose: it must NOT follow camel.version. -->
        <camel.plugin-api.version>4.18.4</camel.plugin-api.version>
        <jackson.version>2.18.3</jackson.version>
        <!-- Spring Boot line matching camel-spring-boot ${camel.version}; overridden by the camel-4.x profiles -->
        <spring-boot.version>3.4.13</spring-boot.version>
        <!-- Quarkus platform whose quarkus-camel-bom carries Camel ${camel.version}; overridden by the camel-4.x profiles.
             The companion itself keeps using quarkus.platform.version. -->
        <bridge-it.quarkus.platform.version>3.20.6.2</bridge-it.quarkus.platform.version>
        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.6</surefire-plugin.version>
        <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
        <spotless-maven-plugin.version>3.10.0</spotless-maven-plugin.version>
        <palantir-java-format.version>2.96.0</palantir-java-format.version>
        <flatten-maven-plugin.version>1.7.0</flatten-maven-plugin.version>
    </properties>

    <modules>
        <module>kaoto-companion</module>
        <module>kaoto-camel-bridge</module>
        <module>kaoto-e2e</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals><goal>flatten</goal></goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals><goal>clean</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler-plugin.version}</version>
                    <configuration>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven-shade-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless-maven-plugin.version}</version>
                    <configuration>
                        <formats>
                            <format>
                                <includes>
                                    <include>*.xml</include>
                                    <include>src/**/*.xml</include>
                                    <include>src/**/*.yaml</include>
                                </includes>
                                <excludes>
                                    <exclude>dependency-reduced-pom.xml</exclude>
                                </excludes>
                                <trimTrailingWhitespace />
                                <endWithNewline />
                            </format>
                        </formats>
                        <java>
                            <palantirJavaFormat>
                                <version>${palantir-java-format.version}</version>
                                <formatJavadoc>true</formatJavadoc>
                            </palantirJavaFormat>
                            <removeUnusedImports />
                            <trimTrailingWhitespace />
                            <endWithNewline />
                        </java>
                    </configuration>
                    <executions>
                        <execution>
                            <id>check-code-style</id>
                            <phase>verify</phase>
                            <goals><goal>check</goal></goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Camel 4.14 LTS: camel-spring-boot 4.14.x is on Spring Boot 3.5; camel-quarkus 3.27.x carries Camel 4.14 -->
        <profile>
            <id>camel-4.14</id>
            <properties>
                <camel.version>4.14.9</camel.version>
                <spring-boot.version>3.5.16</spring-boot.version>
                <bridge-it.quarkus.platform.version>3.27.5.2</bridge-it.quarkus.platform.version>
            </properties>
        </profile>
        <!-- Camel 4.18 LTS: first LTS with ContextServicePlugin; camel-quarkus 3.33.x carries Camel 4.18 -->
        <profile>
            <id>camel-4.18</id>
            <properties>
                <camel.version>4.18.4</camel.version>
                <spring-boot.version>3.5.16</spring-boot.version>
                <bridge-it.quarkus.platform.version>3.33.3.2</bridge-it.quarkus.platform.version>
            </properties>
        </profile>
        <!-- Camel 4.20: camel-quarkus 3.35.x carries Camel 4.20; quarkus platform 3.35.4 -->
        <profile>
            <id>camel-4.20</id>
            <properties>
                <camel.version>4.20.0</camel.version>
                <spring-boot.version>3.5.16</spring-boot.version>
                <bridge-it.quarkus.platform.version>3.35.4</bridge-it.quarkus.platform.version>
            </properties>
        </profile>
        <!-- Camel 4.22: camel-quarkus 3.39.x carries Camel 4.22; quarkus platform 3.39.4 -->
        <profile>
            <id>camel-4.22</id>
            <properties>
                <camel.version>4.22.1</camel.version>
                <spring-boot.version>3.5.16</spring-boot.version>
                <bridge-it.quarkus.platform.version>3.39.4</bridge-it.quarkus.platform.version>
            </properties>
        </profile>
    </profiles>
</project>
