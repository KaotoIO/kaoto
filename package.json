{
  "name": "kaoto",
  "version": "0.0.0-dev",
  "description": "Kaoto - The Integration Designer for Apache Camel",
  "repository": "https://github.com/KaotoIO/kaoto",
  "author": "The Kaoto Team",
  "license": "Apache License v2.0",
  "workspaces": [
    "packages/*"
  ],
  "resolutions": {
    "@patternfly/patternfly": "^6.7.0",
    "@patternfly/react-code-editor": "6.7.0",
    "@patternfly/react-core": "6.7.0",
    "@patternfly/react-drag-drop": "^6.7.0",
    "@patternfly/react-icons": "^6.7.0",
    "@patternfly/react-table": "6.7.0",
    "@patternfly/react-topology": "^6.7.0",
    "dompurify": "3.4.18",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "prettier": "3.7.4"
  },
  "dependenciesMeta": {
    "cypress": {
      "built": true
    }
  },
  "scripts": {
    "postinstall": "husky",
    "version": "lerna version",
    "publish": "lerna publish from-package"
  },
  "engines": {
    "node": ">=22.x"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@lerna-lite/cli": "^5.0.0",
    "@lerna-lite/publish": "^5.0.0",
    "@lerna-lite/version": "^5.0.0",
    "cypress-split": "^1.25.0",
    "fast-xml-parser": "^5.0.9",
    "husky": "^9.0.0",
    "lint-staged": "^17.0.0",
    "simple-git": "^4.0.0"
  },
  "lint-staged": {
    "packages/ui/src/**/*.{ts,tsx,js,jsx}": [
      "yarn workspace @kaoto/kaoto lint:fix"
    ],
    "packages/ui/src/**/*.{css,scss}": [
      "yarn workspace @kaoto/kaoto lint:style:fix"
    ],
    "packages/**/*.{ts,tsx,js,jsx,css,scss,md,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.18.1"
}
