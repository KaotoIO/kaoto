{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Extension (desktop) · webview from Vite dev server",
      "presentation": { "group": "kaoto", "order": 1 },
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--disable-extensions", "--extensionDevelopmentPath=${workspaceFolder}/packages/kaoto-vscode"],
      "outFiles": ["${workspaceFolder}/packages/kaoto-vscode/dist/**/*.js"],
      "sourceMapPathOverrides": {
        "webpack://KaotoEditor/./src/*": "${workspaceFolder}/packages/kaoto-vscode/src/*"
      },
      "debugWebviews": true,
      "rendererDebugOptions": {
        "webRoot": "${workspaceFolder}/packages/ui",
        "sourceMaps": true,
        "resolveSourceMapLocations": null
      },
      "preLaunchTask": "watch:vscode-kaoto",
      "postDebugTask": "stop: @kaoto/kaoto vite dev server",
      "env": {
        "VSCODE_REDHAT_TELEMETRY_DEBUG": "true",
        "KAOTO_DEV_URL": "http://127.0.0.1:5273"
      }
    },
    {
      "name": "Extension (desktop) · prebuilt webview",
      "presentation": { "group": "kaoto", "order": 2 },
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--disable-extensions", "--extensionDevelopmentPath=${workspaceFolder}/packages/kaoto-vscode"],
      "outFiles": ["${workspaceFolder}/packages/kaoto-vscode/dist/**/*.js"],
      "sourceMapPathOverrides": {
        "webpack://KaotoEditor/./src/*": "${workspaceFolder}/packages/kaoto-vscode/src/*"
      },
      "debugWebviews": true,
      "preLaunchTask": "build:webview then watch",
      "env": {
        "VSCODE_REDHAT_TELEMETRY_DEBUG": "true"
      }
    },
    {
      "name": "Extension (web) · prebuilt webview",
      "presentation": { "group": "kaoto", "order": 3 },
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}/packages/kaoto-vscode",
        "--extensionDevelopmentKind=web"
      ],
      "outFiles": ["${workspaceFolder}/packages/kaoto-vscode/dist/**/*.js"],
      "sourceMapPathOverrides": {
        "webpack://KaotoEditor/./src/*": "${workspaceFolder}/packages/kaoto-vscode/src/*"
      },
      "debugWebviews": true,
      "preLaunchTask": "build:webview then watch",
      "env": {
        "VSCODE_REDHAT_TELEMETRY_DEBUG": "true"
      }
    }
  ]
}
